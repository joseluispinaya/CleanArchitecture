@{
    ViewData["Title"] = "Unidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/assets/css/mifileinp.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/plugins/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/plugins/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-lg-3">
        <div class="card shadow rounded-4 text-center overflow-hidden">
            <!-- Banner Header -->
            <div class="py-4 position-relative" style="background: linear-gradient(135deg, #1e3a8a 0%, #0d9488 100%);">
                <span class="badge bg-warning position-absolute top-0 end-0 m-3">
                    <i class="fas fa-circle fa-xs me-1"></i>Ausente
                </span>
            </div>
            <div class="card-body pt-0 px-4 pb-4">
                <!-- Avatar superpuesto -->
                <div class="position-relative d-inline-block" style="margin-top: -45px;">
                    <img src="~/assets/img/user/user-2.jpg" alt="Foto de Perfil"
                         class="rounded-circle border border-4 border-body shadow" width="90" height="90">
                </div>

                <h5 class="fw-bold mt-3 mb-0">Alejandro Silva</h5>
                <p class="small mb-3">Diseñador UI/UX &amp; Product Lead</p>

                <!-- Estadísticas del perfil -->
                <div class="row g-0 py-3 my-2 border-top border-bottom rounded-3 bg-body-secondary bg-opacity-50">
                    <div class="col-4 border-end">
                        <h6 class="fw-bold mb-0">82</h6>
                        <small class="text-muted small">Diseños</small>
                    </div>
                    <div class="col-4 border-end">
                        <h6 class="fw-bold mb-0">5.1k</h6>
                        <small class="text-muted small">Seguidores</small>
                    </div>
                    <div class="col-4">
                        <h6 class="fw-bold mb-0">5.0</h6>
                        <small class="text-muted small">Rating</small>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-primary flex-fill rounded-pill">
                        <i class="fas fa-user-plus me-1"></i>Seguir
                    </button>
                    <button type="button" class="btn btn-outline-secondary flex-fill rounded-pill">
                        <i class="fas fa-envelope me-1"></i>Mensaje
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card shadow border-top border-4 border-primary rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="text-uppercase fw-bold small mb-0">
                        Registro de Unidad Ed
                    </h6>
                    <button type="button" id="btnRegistro" class="btn btn-outline-primary btn-circle btn-circle-sm"
                            title="Agregar Registro">
                        <i class="fas fa-user-plus"></i>
                    </button>
                </div>
                <p class="text-muted mb-4 small">
                    Selector clásico de calendario con resaltado.
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow rounded-4">
            <div class="card-header bg-transparent border-bottom py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="fas fa-user me-2 text-primary"></i>Lista de Unidades ED
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Prueba</span>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table id="tbData" width="100%" class="table table-hover table-striped table-bordered align-middle text-nowrap text-center mb-0">
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdData" tabindex="-1" aria-labelledby="modalUsuarioLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-inverse text-white">
                <h5 class="modal-title" id="modalUsuarioLabel">
                    <i class="fas fa-school me-2"></i><span id="myModalLabel">Nuevo</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Nombre U.E. <span class="text-danger">*</span></label>
                        <input type="text" class="form-control model" id="txtnombres" name="Nombres" placeholder="Nombre U.E."
                               maxlength="50">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Celular <span class="text-danger">*</span></label>
                        <input type="text" class="form-control model" name="Celular" id="txtNroCel" placeholder="Ej: 71234567" maxlength="10">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-dark">Direccion <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa fa-envelope text-muted"></i></span>
                            <input type="text" class="form-control model" name="Direccion" id="txtUbicacion" placeholder="Barrio...." maxlength="150">
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-indigo" id="btnGuardarCambios">
                    <i class="fa fa-save me-1"></i>Guardar Cambios
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/plugins/datatables.net/js/dataTables.min.js"></script>
    <script src="~/assets/plugins/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/plugins/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/plugins/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/UnidadesIndex.js"></script>
}
